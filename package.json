{
  "name": "stella",
  "version": "1.0.0",
  "type": "module",
  "description": "Stella — Illustrated IELTS vocabulary & learning ecosystem. 7,000+ illustrated words, native audio, FSRS spaced repetition, and human-crafted Vietnamese insights. Inspired by Word Atlas.",
  "author": "zhugez",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && rm -rf dist/atlas/audio",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test src/**/*.test.ts",
    "check:atlas": "node scripts/check-atlas.mjs",
    "build:atlas": "python3 scripts/atlas/build_atlas.py",
    "render:cards": "node scripts/render-cards.mjs",
    "pack:public": "python3 scripts/package_public.py --out ../开源发布/word-atlas",
    "oxlint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxlint --fix src"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "wrangler": "4.156.0"
  },
  "private": true,
  "license": "GPL-3.0-only"
}
